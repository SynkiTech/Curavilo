// Curavilo - multi-tenant healthcare operating platform
// Money: ALL amounts are integers in minor units (kobo) + currency code. No floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity & Tenancy ─────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("NGN")
  timezone  String   @default("Africa/Lagos")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities        Facility[]
  memberships       Membership[]
  sessions          Session[]
  facilityCredential FacilityCredential?
  gateSessions      GateSession[]
  customRoles       CustomRole[]
  departments       Department[]

  @@index([name])
}

// Facility access gate credential (ADR 0011). Workspace access only - never an authorization identity.
model FacilityCredential {
  id           String   @id @default(cuid())
  orgId        String   @unique
  email        String   @unique
  passwordHash String
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Short-lived, sliding-TTL server context: "this browser passed the facility gate". Zero permissions.
model GateSession {
  id        String   @id @default(cuid())
  orgId     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Facility {
  id                String  @id @default(cuid())
  orgId             String
  name              String
  type              String  @default("CLINIC")
  serviceProfileKey String  @default("GENERAL_PRACTICE")
  address           String?
  phone             String?
  email             String?
  // Branding (logo stored as sanitized raster data URL)
  logoData       String?
  brandColor     String?
  reportFooter   String?
  receiptFooter  String?
  authorizedSignatory String?
  // Per-facility terminology overrides on top of the service profile (JSON object key -> label)
  termOverrides  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org            Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  staff          StaffMember[]
  users          Session[]            @relation("SessionActiveFacility")
  memberships    FacilityMembership[]

  @@index([orgId])
  @@index([orgId, serviceProfileKey])
}

// Facility-level assignment: a user may only open facilities they are assigned to (ADR 0011).
model FacilityMembership {
  id         String   @id @default(cuid())
  userId     String
  facilityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([facilityId])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean  @default(false)
  // Personnel identity fields (ADR 0011)
  status            String    @default("ACTIVE") // INVITED ACTIVE INACTIVE SUSPENDED LOCKED TERMINATED
  firstName         String?
  lastName          String?
  phone             String?
  staffCode         String?   // employee ID, unique per org
  designation       String?   // professional designation
  employmentStatus  String?   // FULL_TIME PART_TIME CONTRACT LOCUM
  serviceLine       String?   // service profile key assignment
  photoData         String?
  departmentId      String?
  mustChangePassword Boolean  @default(false)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordSetAt     DateTime  @default(now())
  dashboardPrefs    String?   // JSON widget personalization (ADR 0011 §7)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships         Membership[]
  sessions            Session[]
  department          Department?           @relation(fields: [departmentId], references: [id])
  overrides           PermissionOverride[]
  passwordTokens      PasswordToken[]
  facilityMemberships FacilityMembership[]

  @@index([status])
  @@index([departmentId])
}

model Membership {
  id           String  @id @default(cuid())
  userId       String
  orgId        String
  role         String // built-in role key (see src/lib/rbac.ts)
  customRoleId String? // custom role assignment (ADR 0011)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customRole CustomRole?  @relation(fields: [customRoleId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([customRoleId])
}

// Owner-defined role with a selected permission set. Protected permissions are stripped on write.
model CustomRole {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  key         String
  permissions String // JSON array of permission keys
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([orgId, key])
}

// Per-user permission deltas: role defaults + GRANT - DENY. Protected permissions are not grantable.
model PermissionOverride {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  permission String
  effect     String   // GRANT | DENY
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([orgId])
}

// Departments for staff organization (per facility or org-wide).
model Department {
  id         String   @id @default(cuid())
  orgId      String
  facilityId String?
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([orgId, name])
}

// Single-use hashed tokens for staff invitations (INVITE) and password resets (RESET).
model PasswordToken {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  kind      String // INVITE | RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  orgId            String?
  activeFacilityId String?
  tokenHash        String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization? @relation(fields: [orgId], references: [id])
  activeFacility Facility? @relation("SessionActiveFacility", fields: [activeFacilityId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ─── Configuration ──────────────────────────────────────────────────────────

model StaffMember {
  id            String  @id @default(cuid())
  orgId         String
  facilityId    String
  userId        String?
  name          String
  designation   String  @default("DOCTOR") // DOCTOR | NURSE | OPTOMETRIST | RECEPTIONIST | PHARMACIST | LAB_SCIENTIST | CASHIER | ADMIN | OTHER
  department    String?
  active        Boolean @default(true)

  facility     Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  encounters   Encounter[]   @relation("EncounterStaff")
  certifications StaffCertification[]
  leaveRequests  LeaveRequest[]
  referralsReceived Referral[] @relation("ReferralStaff")

  @@index([orgId, facilityId])
  @@index([facilityId, designation])
}

model ServiceItem {
  id          String  @id @default(cuid())
  orgId       String
  facilityId  String?
  code        String
  name        String
  category    String  @default("CONSULTATION") // CONSULTATION | EXAMINATION | PROCEDURE | LAB | IMAGING | MEDICATION | OTHER
  priceMinor  Int
  currency    String  @default("NGN")
  active      Boolean @default(true)

  @@unique([orgId, code])
  @@index([orgId, category])

  appointments Appointment[]
}

// ─── Patient operations ─────────────────────────────────────────────────────

model Patient {
  id             String   @id @default(cuid())
  orgId          String
  facilityId     String
  mrn            String
  firstName      String
  lastName       String
  phone          String
  email          String?
  sex            String   @default("FEMALE") // MALE | FEMALE
  dateOfBirth    DateTime?
  address        String?
  nextOfKinName  String?
  nextOfKinPhone String?
  bloodGroup     String?
  allergies      String?
  consentNote    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments Appointment[]
  queueEntries QueueEntry[]
  encounters   Encounter[]
  invoices     Invoice[]
  followUps    FollowUp[]
  sales        Sale[]
  diagnosticOrders DiagnosticOrder[]
  admissions   Admission[]
  referrals    Referral[]
  portalTokens PortalToken[]

  @@unique([orgId, mrn])
  @@index([orgId, facilityId])
  @@index([orgId, phone])
  @@index([orgId, lastName])
  @@index([facilityId, createdAt])
}

model Appointment {
  id            String   @id @default(cuid())
  orgId         String
  facilityId    String
  patientId     String
  staffMemberId String?
  serviceItemId String?
  scheduledAt   DateTime
  durationMin   Int      @default(30)
  status        String   @default("SCHEDULED") // SCHEDULED | CHECKED_IN | COMPLETED | CANCELLED | NO_SHOW
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient     Patient       @relation(fields: [patientId], references: [id])
  staffMember StaffMember?  @relation(fields: [staffMemberId], references: [id])
  serviceItem ServiceItem?  @relation(fields: [serviceItemId], references: [id])

  @@index([orgId, facilityId, scheduledAt])
  @@index([orgId, patientId])
  @@index([orgId, status])
}

model QueueEntry {
  id            String   @id @default(cuid())
  orgId         String
  facilityId    String
  patientId     String
  appointmentId String?
  department    String   @default("GENERAL")
  number        Int
  status        String   @default("WAITING") // WAITING | CALLED | IN_SERVICE | COMPLETED | SKIPPED
  priority      String   @default("NORMAL")  // NORMAL | URGENT
  checkedInAt   DateTime @default(now())
  calledAt      DateTime?
  completedAt   DateTime?

  patient Patient @relation(fields: [patientId], references: [id])
  encounters Encounter[]

  @@unique([orgId, facilityId, department, number, checkedInAt]) // number resets daily; uniqueness guarded in module
  @@index([orgId, facilityId, status])
  @@index([orgId, patientId])
}

model Encounter {
  id            String    @id @default(cuid())
  orgId         String
  facilityId    String
  patientId     String
  appointmentId String?
  queueEntryId  String?
  staffMemberId String?
  serviceLine   String    @default("GENERAL")
  formKey       String    @default("GENERAL_CONSULT")
  status        String    @default("OPEN") // OPEN | COMPLETED
  formData      String    @default("{}")
  diagnosis     String?
  plan          String?
  chargeItemIds String?   // comma-separated ServiceItem ids chosen at completion
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  patient    Patient      @relation(fields: [patientId], references: [id])
  staffMember StaffMember? @relation("EncounterStaff", fields: [staffMemberId], references: [id])
  queueEntry QueueEntry?  @relation(fields: [queueEntryId], references: [id])
  invoices   Invoice[]

  @@index([orgId, facilityId, startedAt])
  @@index([orgId, patientId, status])
}

model FollowUp {
  id          String   @id @default(cuid())
  orgId       String
  facilityId  String
  patientId   String
  encounterId String?
  title       String
  dueAt       DateTime
  status      String   @default("PENDING") // PENDING | COMPLETED | CANCELLED
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([orgId, status, dueAt])
  @@index([orgId, patientId])
}

// ─── Finance ────────────────────────────────────────────────────────────────

model Invoice {
  id              String    @id @default(cuid())
  orgId           String
  facilityId      String
  patientId       String
  encounterId     String?
  number          String
  status          String    @default("DRAFT") // DRAFT | ISSUED | PARTIALLY_PAID | PAID | VOID
  subtotalMinor   Int
  discountMinor   Int       @default(0)
  totalMinor      Int
  amountPaidMinor Int       @default(0)
  currency        String    @default("NGN")
  note            String?
  issuedAt        DateTime?
  voidedAt        DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient   Patient       @relation(fields: [patientId], references: [id])
  encounter Encounter?    @relation(fields: [encounterId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@unique([orgId, number])
  @@index([orgId, facilityId, status])
  @@index([orgId, patientId])
  @@index([orgId, createdAt])
}

model InvoiceItem {
  id              String @id @default(cuid())
  invoiceId       String
  orgId           String
  serviceItemId   String?
  name            String
  quantity        Int    @default(1)
  unitPriceMinor  Int
  totalMinor      Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id          String    @id @default(cuid())
  orgId       String
  facilityId  String
  invoiceId   String
  number      String // receipt number RCP-…
  method      String    @default("CASH") // CASH | TRANSFER | CARD | MOBILE
  amountMinor Int
  currency    String    @default("NGN")
  reference   String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String
  createdAt   DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([orgId, number])
  @@index([orgId, invoiceId])
  @@index([orgId, facilityId, createdAt])
}

// ─── Supply chain (POS + inventory) ─────────────────────────────────────────

model InventoryItem {
  id                String  @id @default(cuid())
  orgId             String
  facilityId        String
  category          String  @default("PHARMACEUTICAL") // PHARMACEUTICAL | CONSUMABLE | LAB | EQUIPMENT | OFFICE | OTHER
  sku               String
  barcode           String?
  name              String
  genericName       String?
  dosageForm        String?
  unit              String  @default("unit")
  purchasePriceMinor Int    @default(0)
  sellingPriceMinor Int    @default(0)
  currency          String  @default("NGN")
  reorderLevel      Int     @default(10)
  supplierId        String?
  active            Boolean @default(true)
  createdAt         DateTime @default(now())

  supplier Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lots     StockLot[]
  poLines  PurchaseOrderItem[]

  @@unique([orgId, sku])
  @@index([orgId, facilityId, category])
  @@index([orgId, name])
  @@index([orgId, barcode])
}

model StockLot {
  id           String    @id @default(cuid())
  orgId        String
  itemId       String
  batchNo      String
  expiresAt    DateTime?
  qtyReceived  Int
  qtyRemaining Int
  createdAt    DateTime  @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([orgId, expiresAt])
}

model StockMovement {
  id        String   @id @default(cuid())
  orgId     String
  itemId    String
  lotId     String?
  type      String // RECEIPT | SALE | DISPENSE | ADJUSTMENT | DAMAGE | TRANSFER | RETURN
  quantity  Int // signed: +in / -out
  reason    String?
  refType   String?
  refId     String?
  userId    String
  createdAt DateTime @default(now())

  @@index([orgId, itemId, createdAt])
}

model Sale {
  id              String    @id @default(cuid())
  orgId           String
  facilityId      String
  number          String
  patientId       String?
  customerName    String?
  status          String    @default("COMPLETED") // COMPLETED | VOID
  subtotalMinor   Int
  discountMinor   Int       @default(0)
  totalMinor      Int
  amountPaidMinor Int
  method          String    @default("CASH")
  reference       String?
  voidedAt        DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  patient Patient?    @relation(fields: [patientId], references: [id])
  items   SaleItem[]
  returns SaleReturn[]

  @@unique([orgId, number])
  @@index([orgId, facilityId, createdAt])
}

model SaleItem {
  id             String @id @default(cuid())
  saleId         String
  orgId          String
  itemId         String
  name           String
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model SaleReturn {
  id          String   @id @default(cuid())
  orgId       String
  facilityId  String
  number      String // RET-… credit note
  saleId      String
  saleNumber  String // denormalized for quick display
  reason      String
  method      String   @default("CASH") // CASH | TRANSFER | CARD | MOBILE | CREDIT
  totalMinor  Int
  restocked   Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  sale  Sale            @relation(fields: [saleId], references: [id])
  items SaleReturnItem[]

  @@unique([orgId, number])
  @@index([orgId, facilityId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id            String @id @default(cuid())
  orgId         String
  saleReturnId  String
  saleItemId    String?
  itemId        String
  name          String
  quantity      Int
  unitPriceMinor Int
  totalMinor    Int

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
}

model HeldSale {
  id            String   @id @default(cuid())
  orgId         String
  facilityId    String
  label         String?
  customerName  String?
  patientId     String?
  itemsJson     String // [{itemId,name,sku,quantity,unitPriceMinor}]
  discountMinor Int      @default(0)
  totalMinor    Int
  createdById   String
  createdAt     DateTime @default(now())

  @@index([orgId, facilityId, createdAt])
}

model Supplier {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@index([orgId, name])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  orgId       String
  facilityId  String
  number      String // PO-…
  supplierId  String
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | PARTIAL | RECEIVED | CANCELLED
  expectedAt  DateTime?
  notes       String?
  receivedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([orgId, number])
  @@index([orgId, facilityId, status])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  orgId           String
  purchaseOrderId String
  itemId          String
  quantity        Int
  quantityReceived Int   @default(0)
  unitCostMinor   Int    @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
}

// ─── Workflow & automation ──────────────────────────────────────────────────

model WorkflowDef {
  id          String    @id @default(cuid())
  orgId       String
  key         String
  name        String
  description String?
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  version     Int       @default(1)
  definition  String // JSON: { trigger, nodes: [...], edges: [...], schedule?, slaMinutes? } - declarative, no executable code
  slaMinutes  Int? // run-level SLA; breach detected by scheduler
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs WorkflowRun[]

  @@unique([orgId, key])
  @@index([orgId, status])
}

model WorkflowRun {
  id             String    @id @default(cuid())
  orgId          String
  workflowDefId  String
  version        Int
  triggerType    String // ENCOUNTER_COMPLETED | MANUAL | PAYMENT_RECEIVED | SCHEDULED | CUSTOM_WEBHOOK | …
  triggerRefId   String?
  correlationId  String? // idempotent event correlation (def+ref dedupe)
  status         String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | CANCELLED
  dryRun         Boolean   @default(false)
  state          String    @default("{}") // JSON persisted run state
  lastError      String?
  slaBreachedAt  DateTime?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  workflowDef WorkflowDef       @relation(fields: [workflowDefId], references: [id])
  nodes       WorkflowRunNode[]

  @@index([orgId, status])
  @@index([orgId, workflowDefId])
  @@index([orgId, correlationId])
}

model WorkflowRunNode {
  id             String    @id @default(cuid())
  orgId          String
  runId          String
  nodeKey        String
  type           String
  status         String    @default("PENDING") // PENDING | RUNNING | SLEEPING | WAITING_APPROVAL | COMPLETED | SKIPPED | FAILED
  attempts       Int       @default(0)
  idempotencyKey String?
  output         String? // JSON result of the node execution
  error          String?
  wakeAt         DateTime? // DELAY nodes + retry backoff
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeKey])
  @@index([orgId, status, wakeAt])
}

model OutboxEvent {
  id              String    @id @default(cuid())
  orgId           String
  type            String
  payload         String
  dispatchAttempts Int      @default(0)
  lastError       String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([orgId, processedAt])
}

model Task {
  id             String    @id @default(cuid())
  orgId          String
  facilityId     String?
  title          String
  description    String?
  assigneeUserId String?
  role           String?
  priority       String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueAt          DateTime?
  status         String    @default("OPEN") // OPEN | COMPLETED | CANCELLED
  kind           String    @default("GENERAL") // GENERAL | APPROVAL
  decision       String? // APPROVED | REJECTED (approval tasks)
  decidedById    String?
  decidedAt      DateTime?
  source         String    @default("USER") // USER | WORKFLOW | AI | SYSTEM
  sourceId       String?
  slaNotifiedAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([orgId, status])
  @@index([orgId, assigneeUserId])
  @@index([orgId, kind, status])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  userId    String?
  role      String?
  type      String    @default("SYSTEM")
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId, userId, readAt])
}

// ─── Communications & webhooks (Phase 6) ───────────────────────────────────

model CommunicationMessage {
  id              String    @id @default(cuid())
  orgId           String
  facilityId      String?
  channel         String // EMAIL | SMS | WHATSAPP | IN_APP
  type            String    @default("GENERAL") // APPOINTMENT_REMINDER | PAYMENT_CONFIRMATION | …
  recipient       String? // email address / phone / role target
  recipientUserId String?
  subject         String?
  bodyPreview     String? // truncated, non-sensitive-safe
  status          String    @default("QUEUED") // QUEUED | SENT | SIMULATED | FAILED
  provider        String    @default("console")
  providerRef     String?
  error           String?
  source          String    @default("MANUAL") // WORKFLOW | MANUAL | SYSTEM | SCHEDULER
  sourceId        String?
  createdAt       DateTime  @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, channel, status])
}

model ProviderConfig {
  id         String   @id @default(cuid())
  orgId      String
  channel    String // EMAIL | SMS | WHATSAPP
  provider   String   @default("console") // console (dev simulation) | provider key
  configJson String   @default("{}") // provider credentials live in env in production; only non-secret metadata here
  updatedAt  DateTime @updatedAt

  @@unique([orgId, channel])
}

model WebhookEndpoint {
  id         String   @id @default(cuid())
  orgId      String
  key        String   @unique
  url        String
  secretHash String
  events     String // CSV of event types this endpoint subscribes to
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  orgId          String
  endpointId     String
  eventType      String
  payload        String
  status         String    @default("PENDING") // PENDING | DELIVERED | FAILED | DEAD
  attempts       Int       @default(0)
  responseStatus Int?
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([orgId, status, nextAttemptAt])
}

// ─── Diagnostics / inpatient / referrals (Phase 9) ─────────────────────────

model DiagnosticOrder {
  id                   String    @id @default(cuid())
  orgId                String
  facilityId           String
  patientId            String
  encounterId          String?
  kind                 String    @default("LAB") // LAB | IMAGING
  serviceItemId        String?
  testName             String
  modality             String? // XRAY | ULTRASOUND | CT | MRI (IMAGING)
  priority             String    @default("ROUTINE") // ROUTINE | URGENT
  status               String    @default("ORDERED") // ORDERED | SPECIMEN_COLLECTED | RESULT_ENTERED | VERIFIED | RELEASED | CANCELLED
  clinicalNotes        String?
  orderedById          String
  orderedAt            DateTime  @default(now())
  specimenSite         String?
  specimenCollectedById String?
  specimenCollectedAt  DateTime?
  resultsJson          String? // [{name, value, unit, refRange, flag}]
  impression           String?
  verifiedById         String?
  verifiedAt           DateTime?
  releasedById         String?
  releasedAt           DateTime?
  turnaroundMin        Int?
  reportNumber         String?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([orgId, facilityId, status])
  @@index([orgId, patientId])
  @@index([orgId, kind, status])
}

model Ward {
  id           String  @id @default(cuid())
  orgId        String
  facilityId   String
  name         String
  genderPolicy String  @default("MIXED") // MALE | FEMALE | MIXED
  active       Boolean @default(true)

  beds       Bed[]
  admissions Admission[]

  @@index([orgId, facilityId])
}

model Bed {
  id        String  @id @default(cuid())
  orgId     String
  wardId    String
  label     String
  status    String  @default("FREE") // FREE | OCCUPIED | MAINTENANCE

  ward       Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions Admission[]

  @@unique([wardId, label])
  @@index([orgId, status])
}

model Admission {
  id               String    @id @default(cuid())
  orgId            String
  facilityId       String
  patientId        String
  wardId           String
  bedId            String
  encounterId      String?
  reason           String
  admittedById     String
  admittedAt       DateTime  @default(now())
  status           String    @default("ADMITTED") // ADMITTED | DISCHARGED
  dischargedAt     DateTime?
  dischargeSummary String?
  dischargeById    String?

  patient Patient @relation(fields: [patientId], references: [id])
  bed     Bed     @relation(fields: [bedId], references: [id])
  ward    Ward    @relation(fields: [wardId], references: [id])

  @@index([orgId, facilityId, status])
  @@index([orgId, patientId])
}

model Referral {
  id               String    @id @default(cuid())
  orgId            String
  facilityId       String
  patientId        String
  encounterId      String?
  direction        String    @default("INTERNAL") // INTERNAL | EXTERNAL
  toServiceLine    String?
  toStaffMemberId  String?
  externalFacility String?
  notes            String?
  status           String    @default("PENDING") // PENDING | ACCEPTED | COMPLETED | CANCELLED
  createdById      String
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  patient       Patient      @relation(fields: [patientId], references: [id])
  toStaffMember StaffMember? @relation("ReferralStaff", fields: [toStaffMemberId], references: [id])

  @@index([orgId, facilityId, status])
  @@index([orgId, patientId])
}

// ─── Generated documents, ops alerts, simulation (Phases 10–11) ────────────

model GeneratedDocument {
  id          String   @id @default(cuid())
  orgId       String
  facilityId  String
  kind        String // REPORT | AI_REPORT | DISCHARGE_SUMMARY | LAB_REPORT | REFERRAL_LETTER | WORKFLOW_DOC
  title       String
  contentJson String // structured document content (sections/tables) rendered by the document engine
  sourceId    String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([orgId, kind, createdAt])
}

model OpsAlert {
  id             String    @id @default(cuid())
  orgId          String
  facilityId     String?
  metric         String
  severity       String    @default("WARNING") // INFO | WARNING | CRITICAL
  value          String
  baseline       String?
  message        String
  fingerprint    String? // dedupe key per metric+window
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([orgId, createdAt])
  @@unique([orgId, fingerprint])
}

model SimulationScenario {
  id          String   @id @default(cuid())
  orgId       String
  facilityId  String
  name        String
  paramsJson  String
  resultJson  String?
  seed        Int?
  createdById String
  createdAt   DateTime @default(now())

  @@index([orgId, facilityId, createdAt])
}

// ─── Portals & staff records (Phase 13) ────────────────────────────────────

model StaffCertification {
  id        String   @id @default(cuid())
  orgId     String
  staffId   String
  name      String
  expiresAt DateTime

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([orgId, expiresAt])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  orgId       String
  facilityId  String
  staffId     String
  fromAt      DateTime
  toAt        DateTime
  reason      String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model PortalToken {
  id         String    @id @default(cuid())
  orgId      String
  facilityId String
  patientId  String
  tokenHash  String    @unique
  label      String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdById String
  createdAt  DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([orgId, patientId])
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditEvent {
  id          String   @id @default(cuid())
  orgId       String?
  facilityId  String?
  actorUserId String?
  actorLabel  String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, action])
}

// ─── AI ─────────────────────────────────────────────────────────────────────

model AIConversation {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  facilityId String?
  title      String   @default("New conversation")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages AIMessage[]

  @@index([orgId, userId, updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  toolCalls      String?
  provenance     String?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Document numbering ─────────────────────────────────────────────────────

model NumberSequence {
  id  String @id // "{orgId}:{type}:{period}"
  seq Int    @default(0)
}
